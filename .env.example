# Copy to .env (git-ignored). Every VITE_* value is validated in src/lib/env.ts.

# "enabled" → the app runs against the MSW mocks in src/mocks/ (no backend needed).
# "disabled" → real HTTP requests go to VITE_API_URL.
VITE_API_MOCKING=enabled

# Where the API lives. Relative ("/api", same origin) or absolute ("https://api.example.com").
VITE_API_URL=/api

# Dev only, never sent to the browser: forward /api/* to a local or staging backend.
# Use it with VITE_API_MOCKING=disabled and VITE_API_URL=/api to avoid CORS.
# API_PROXY_TARGET=http://localhost:8080
