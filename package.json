{
  "name": "react-sdd-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "doctor": "react-doctor --scope changed --include-untracked --no-score",
    "check": "npm run ready && npm run typecheck && npm run lint && npm run format:check && npm run harness:check && npm run test:coverage && npm run doctor",
    "gen:api": "rtk-query-codegen-openapi openapi-config.ts",
    "mocks:init": "msw init public/ --save",
    "test:coverage": "vitest run --coverage",
    "features": "node scripts/harness/features.mjs",
    "progress": "node scripts/harness/progress.mjs",
    "scope": "node scripts/harness/scope.mjs",
    "ready": "node scripts/harness/ready.mjs",
    "harness:check": "node scripts/harness/features.mjs check && node scripts/harness/instructions.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/react": "^11.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.15.0",
    "@playwright/test": "^1.64.1",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "react-doctor": "^0.9.18",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8",
    "vite": "^8.3.5",
    "vitest": "^5.0.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "@vitest/mocker": {
      "msw": "$msw"
    }
  }
}
